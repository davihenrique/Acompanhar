@model IEnumerable<Acompanhar.Models.Alternativa>

@{
    ViewData["Title"] = "Início";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="BackToQuestao">Voltar</a></br>
    <a asp-action="Create">Criar Nova Alterantiva</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Rotulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Afirmacao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Verdadeira)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Rotulo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Afirmacao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Verdadeira)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
