@model Acompanhar.Models.Alternativa

@{
    ViewData["Title"] = "Deletar";
}

<h1>@ViewData["Title"]</h1>

<h3>Você tem certeza que deseja deletar isso ?</h3>
<div>
    <h4>Alternativa</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Rotulo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rotulo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Afirmacao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Afirmacao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Verdadeira)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Verdadeira)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Deletar" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar Para Lista</a>
    </form>
</div>
