@model IEnumerable<Acompanhar.Models.Questionario>

@{
    ViewData["Title"] = "Questionário";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Exit">Sair</a></br>
    <a asp-action="Create">Criar Novo Questionário</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Tema)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Tema)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Deletar</a> |
                <a asp-action="Questao" asp-route-id="@item.Id">Gerenciar Questões</a>
            </td>
        </tr>
}
    </tbody>
</table>
