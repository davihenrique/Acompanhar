@model Acompanhar.Models.Questionario

@{
    ViewData["Title"] = "Create";
}


<h1>Criar Questionario</h1>

<h4>Questionario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">

                <label asp-for="IdProfessor" class="control-label"></label>
                <input asp-for="IdProfessor" class="form-control" />
                <span asp-validation-for="IdProfessor" class="text-danger"></span>
            </div>
            <div class="form-group">

                <label asp-for="Tema" class="control-label"></label>
                <input asp-for="Tema" class="form-control" />
                <span asp-validation-for="Tema" class="text-danger"></span>
            </div>


            @{ 
           
            }

            @for (var i = 1; i <= 10; i++)
            {
                <div class="border border-secondary rounded" style="padding:3%;">
                    <span>Pergunta @i</span>
                    <br />
                    <div class="form-group">

                        <label asp-for="Questao1.Enunciado" class="control-label"></label>
                        <input asp-for="Questao1.Enunciado" class="form-control" />
                    </div>
                    <div class="form-group">

                        <label asp-for="Questao1.AlternativaA" class="control-label"></label>
                        <input asp-for="Questao1.AlternativaA" class="form-control" />
                    </div>
                    <div class="form-group">

                        <label asp-for="Questao1.AlternativaB" class="control-label"></label>
                        <input asp-for="Questao1.AlternativaB" class="form-control" />
                    </div>
                    <div class="form-group">

                        <label asp-for="Questao1.AlternativaC" class="control-label"></label>
                        <input asp-for="Questao1.AlternativaC" class="form-control" />
                    </div>
                    <div class="form-group">

                        <label asp-for="Questao1.AlternativaD" class="control-label"></label>
                        <input asp-for="Questao1.AlternativaD" class="form-control" />
                    </div>
                    <div class="form-group">

                        <label asp-for="Questao1.AlternativaE" class="control-label"></label>
                        <input asp-for="Questao1.AlternativaE" class="form-control" />
                    </div>
                    <div class="form-group">

                        <label asp-for="Questao1.Justificativa" class="control-label"></label>
                        <input asp-for="Questao1.Justificativa" class="form-control" />
                    </div>
                    <div class="form-group">

                        <label asp-for="Questao1.Resposta" class="control-label"></label>
                        <select class="form-select" aria-label="Default select example" asp-for="Questao1.Resposta">
                            <option selected>Selecione a Alternativa Correta</option>
                            <option value="A">Alternativa A</option>
                            <option value="B">Alternativa B</option>
                            <option value="C">Alternativa C</option>
                            <option value="D">Alternativa D</option>
                            <option value="E">Alternativa E</option>
                        </select>
                    </div>
                </div><br />

            }


                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
