@model Acompanhar.ViewModels.FeedbackViewModel
@{
    ViewData["Title"] = "Feedback";
}

<h1>Feedback</h1>
<h2>Sua nota é : 
    
    @ViewData["nota"]
    
    </h2>


<br />

<form class="form1" method="post" asp-action="Feedback">

    <div>
        <div class="form-group">
            <label for="msg">Feedback:</label><br />
            
            <textarea class="form-control" id="exampleFormControlTextarea1" rows="3" asp-for="Message"></textarea>
        </div>
        <div class="form-group">
            <input class="btn btn-primary" type="submit" value="Enviar" />
        </div>
    </div>
</form>