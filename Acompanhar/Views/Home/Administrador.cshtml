@model Acompanhar.Models.GenericLoginAdministrator
@{
    ViewData["Title"] = "Adminstrador";
}

@section styles{
    <link href="~/css/estiloLogin.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Ubuntu" rel="stylesheet">
}

<div class="main">
    <p class="sign" align="center">Tela de Login Administrador</p>
    <form class="form1" asp-action="LoginAdminstrador" method="post">
        <input class="un " type="text" align="center" placeholder="Name" name="Name" asp-for="Name">
        <input class="pass" type="password" align="center" placeholder="Senha" name="senha" asp-for="Senha">
        <input class="submit" type="submit" value="Entrar" />

    </form>

</div>