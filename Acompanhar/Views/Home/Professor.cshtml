@{
    ViewData["Title"] = "Professor";
}

@section styles{
    <link href="~/css/estiloLogin.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Ubuntu" rel="stylesheet">
}

<div class="main">
    <p class="sign" align="center">Tela de Login</p>
    <form class="form1">
        <input class="un " type="email" align="center" placeholder="E-Mail">
        <input class="pass" type="password" align="center" placeholder="Senha">
        <a class="submit" class="link" align="center">Entrar</a>
        <p class="forgot" align="center"><a href="#" class="link">Esqueceu a senha ?</a></p>
    </form>

</div>