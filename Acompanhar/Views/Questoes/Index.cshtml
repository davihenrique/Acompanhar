@model IEnumerable<Acompanhar.Models.Questao>

@{
    ViewData["Title"] = "Quetões";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="BackToQuestionario">Voltar</a></br>
    <a asp-action="Create">Criar Nova Questão</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Enunciado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Justificativa)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Enunciado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Justificativa)
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Deletar</a> |
                <a asp-action="GerenciarAlternativa" asp-route-id="@item.Id">Gerenciar Alternativas</a>
            </td>
        </tr>
}
    </tbody>
</table>
