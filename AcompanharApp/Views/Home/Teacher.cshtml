@model AcompanharApp.ViewModels.GenericLoginViewModel

@section styles{
    <link href="~/css/estiloLogin.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Ubuntu" rel="stylesheet">
}
<div class="main">
    <p class="sign" align="center">Tela de Login</p>
    <form class="form1" asp-controller="Questionarios" asp-action="index" method="post">
        <input class="un " type="email" align="center" placeholder="E-Mail" name="email" asp-for="Email">
        <input class="pass" type="password" align="center" placeholder="Senha" name="password" asp-for="Password">
        <input class="submit" type="submit" value="Entrar" />
        
    </form>

</div>