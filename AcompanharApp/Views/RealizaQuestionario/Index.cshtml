@model AcompanharApp.ViewModels.QuestionarioViewModel

@{
    ViewData["Title"] = "Questionário";
}

<h1>@ViewData["Title"]</h1>
<h2>Tema: <b>@ViewData["Tema"]</b></h2>
<br />
<form asp-action="Result" method="post">

    <div class="form-group">
        <label><b>@ViewData["QuestaoAtual"])</b> @Html.DisplayFor(modelItem => modelItem.Question)</label>
    </div>

    @for (int i = 0; i < Model.Alternatives.Count; i++)
    {
        <input asp-for="Alternatives[i].Label" type="hidden" />
        <input asp-for="Alternatives[i].Text" type="hidden" />

        <div class="form-check">
            <input asp-for="Alternatives[i].Selected" class="form-check-input" />
            <label class="form-check-label" asp-for="Alternatives[i].Selected">
                <b>@Model.Alternatives[i].Label</b>
                @Model.Alternatives[i].Text
                <br />
            </label>
        </div>
    }

    <br />
    <button type="submit" class="btn btn-primary">Enviar</button>
</form>
<br />
<span>Total de questões: @ViewData["NumeroDeQuestao"]</span>