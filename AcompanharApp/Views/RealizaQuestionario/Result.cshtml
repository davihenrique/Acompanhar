@model AcompanharApp.ViewModels.RespostaViewModel
@{
    ViewData["Title"] = "Resultado";
}

<h1>Resultado</h1>

<p>Você Marcou: <b>@Html.DisplayFor(modelItem => modelItem.Checked)</b>  </p>
<p>A Resposta Certa é: <b>@Html.DisplayFor(modelItem => modelItem.CorrectAnswer)</b></p>

<p>Justificativa:</p>
<p> @Html.DisplayFor(modelItem => modelItem.Justification)</p>




<input type="button" value="Proximo" class="btn btn-primary" onclick="location.href='@Url.Action("Index", "RealizaQuestionario")'" />